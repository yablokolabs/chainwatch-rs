# Chainwatch local configuration. Copy to .env and adjust.
# Keep real provider URLs and database credentials out of git.
CHAINWATCH__APP__MODE=all
CHAINWATCH__API__BIND_ADDR=0.0.0.0:8080
CHAINWATCH__API__CORS_ALLOW_ORIGIN=*
CHAINWATCH__API__RATE_LIMIT_PER_SECOND=100
CHAINWATCH__API__REQUEST_TIMEOUT_SECONDS=30

# Local Docker Compose uses a passwordless trust-auth development database.
# For production, replace this with a secret-managed DSN.
CHAINWATCH__DATABASE__URL=postgres://chainwatch_app@localhost:5432/chainwatch
CHAINWATCH__DATABASE__MAX_CONNECTIONS=10
CHAINWATCH__DATABASE__RUN_MIGRATIONS=true

CHAINWATCH__REDIS__URL=redis://localhost:6379/0

# Use a real Ethereum-compatible RPC for production.
CHAINWATCH__EVM__CHAIN_NAME=ethereum-mainnet
CHAINWATCH__EVM__RPC_URL=http://localhost:8545
# Optional; when unset, chainwatch calls eth_chainId.
# CHAINWATCH__EVM__CHAIN_ID_OVERRIDE=1

CHAINWATCH__INDEXER__START_BLOCK=0
CHAINWATCH__INDEXER__REORG_CONFIRMATIONS=12
CHAINWATCH__INDEXER__BACKFILL_BATCH_SIZE=25
CHAINWATCH__INDEXER__RPC_CONCURRENCY=8
CHAINWATCH__INDEXER__POLL_INTERVAL_SECONDS=12
CHAINWATCH__INDEXER__MAX_RETRIES=5
CHAINWATCH__INDEXER__INITIAL_RETRY_DELAY_MS=250
CHAINWATCH__INDEXER__MAX_RETRY_DELAY_MS=5000

CHAINWATCH__RISK__LARGE_TRANSFER_THRESHOLD_WEI=100000000000000000000000
CHAINWATCH__RISK__HIGH_FREQUENCY_THRESHOLD=25
CHAINWATCH__RISK__HIGH_FREQUENCY_WINDOW_SECONDS=3600
CHAINWATCH__RISK__SUSPICIOUS_CONTRACT_RULE_ENABLED=true

CHAINWATCH__TELEMETRY__LOG_LEVEL=info,sqlx=warn,tower_http=info
CHAINWATCH__TELEMETRY__JSON_LOGS=true
# CHAINWATCH__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
